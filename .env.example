# Copy to .env, fill in local values, then export before running Spring Boot.
# Spring Boot does not automatically load .env files.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=finance_app
DB_USERNAME=postgres
DB_PASSWORD=
# Optional full JDBC URL overrides the host/port/name settings above.
# DB_URL=jdbc:postgresql://localhost:5432/finance_app

# Generate with: openssl rand -hex 32
JWT_SECRET=

PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=

# Optional. Without a key, the app starts and chat returns HTTP 503.
GEMINI_API_KEY=

# Only needed when hosting the frontend on a different origin.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
